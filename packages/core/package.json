{
  "name": "@abijith-suresh/runnel-core",
  "version": "0.0.5",
  "description": "Shared application concepts and database target selection for Runnel.",
  "type": "module",
  "license": "MIT",
  "author": "abijith-suresh",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abijith-suresh/runnel.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/abijith-suresh/runnel#readme",
  "bugs": {
    "url": "https://github.com/abijith-suresh/runnel/issues"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --project tsconfig.typecheck.json && tsc --project tsconfig.test.json",
    "test": "npm run build && node --test test/*.test.mts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "effect": "4.0.1"
  }
}
