{
  "name": "runnel-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/core",
    "packages/mongodb",
    "apps/cli"
  ],
  "scripts": {
    "build": "tsc --build && npm run build:ui --workspace @abijith-suresh/runnel",
    "clean": "node scripts/clean.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:check": "node scripts/release-policy.mjs --pr",
    "release-policy": "node scripts/release-policy.mjs",
    "version:packages": "node scripts/version-packages.mjs",
    "test:policy": "node --test scripts/*.test.mjs",
    "test": "npm run test --workspaces --if-present",
    "pack:check": "npm run build && node scripts/pack-check.mjs",
    "verify": "npm run release-policy && npm run format:check && npm run lint && npm run build && npm run typecheck && npm run test:policy && npm run test && npm run pack:check && npm run check:prerelease",
    "prepare": "husky",
    "check:native-credentials": "npm run build && node scripts/check-native-credentials.mjs",
    "check:mongodb": "npm run build && node scripts/pack-check.mjs --mongodb",
    "install:local": "npm run build && node scripts/local-install.mjs",
    "check:mongodb-auth": "npm run build && node scripts/check-auth-mongodb.mjs",
    "test:ui": "npm run build && node scripts/ui-browser-check.mjs",
    "prepare:prerelease": "node scripts/prerelease.mjs",
    "check:prerelease": "node scripts/check-prerelease.mjs",
    "install:prerelease": "node scripts/install-prerelease.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,css,html,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@changesets/parse": "1.0.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.1",
    "@types/proper-lockfile": "4.1.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "solid-js": "1.9.17",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14"
  }
}
