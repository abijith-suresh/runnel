---
import monoUrl from "../assets/fonts/IBMPlexMono-Regular.woff2";
import sansUrl from "../assets/fonts/IBMPlexSansVar-Roman.woff2";
import "../styles/global.css";

const title = "Runnel | Named MongoDB access for agents";
const description =
  "Register a MongoDB connection once. Give agents named environments and database aliases for queries, native JavaScript scripts, and bounded EJSON exports.";
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141718" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={sansUrl} />
    <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={monoUrl} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <div class="page-shell">
      <header class="site-header">
        <a href={base} class="wordmark" aria-label="Runnel home">
          <svg width="22" height="22" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <path
              d="M9 5v30m0-17c0-8 12-13 22-9M9 23c0-7 12-10 22-7"
              stroke="currentColor"
              stroke-width="3"
            />
          </svg>
          runnel
        </a>
        <nav aria-label="Main navigation">
          <a href="https://github.com/abijith-suresh/runnel/blob/main/apps/cli/README.md">
            CLI docs
          </a>
          <a href="https://github.com/abijith-suresh/runnel">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <p>Runnel · Early stage, MongoDB today.</p>
        <nav aria-label="Footer navigation">
          <a href="https://github.com/abijith-suresh/runnel/blob/main/CONTRIBUTING.md">
            Contributing
          </a>
          <a href={`${base}fonts/LICENSE.txt`}>Font license</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
